# Cloud Native Topic Scanner - Environment Configuration
# Copy this file to .env and update the values as needed

# Docker Configuration
DOCKER_BINARY=docker
DOCKER_COMPOSE_BINARY=docker-compose
PLATFORM=linux/amd64
REGISTRY=localhost:5000
VERSION=latest
NAMESPACE=topic-scanner

# Maven Configuration
MAVEN_OPTS=-Xmx1024m
MAVEN_BINARY=mvn

# Test Configuration
TEST_PROFILE=test
COVERAGE_THRESHOLD=80

# Docker Build Configuration
DOCKER_BUILDX=false
DOCKER_PUSH=false
DOCKER_CACHE=true

# Database Configuration
POSTGRES_DB=topic_scanner
POSTGRES_USER=topic_scanner
POSTGRES_PASSWORD=topic_scanner_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NAME=topic-scanner

# AI Configuration
AI_ENABLED=true
AI_SIMILARITY_THRESHOLD=0.8
AI_DUPLICATE_DETECTION_ENABLED=true

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Ollama Configuration (Alternative to OpenAI)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1000

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT_TOPIC_SCANNER=8080
SERVER_PORT_TOPIC_ANALYZER=8081
SERVER_PORT_WEBUI=8082

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# Security Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=86400000

# Monitoring Configuration
ACTUATOR_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# Development Tools
KAFKA_UI_ENABLED=true
KAFKA_UI_PORT=8083
PGADMIN_ENABLED=true
PGADMIN_PORT=8084
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Kubernetes Configuration
K8S_NAMESPACE=topic-scanner
K8S_CONTEXT=default
K8S_CONFIG_PATH=~/.kube/config

# CI/CD Configuration
CI_ENABLED=false
CD_ENABLED=false
DEPLOYMENT_ENVIRONMENT=development

# Performance Configuration
JVM_HEAP_SIZE=512m
JVM_METASPACE_SIZE=256m
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=10

# Feature Flags
FEATURE_AI_ANALYSIS=true
FEATURE_DUPLICATE_DETECTION=true
FEATURE_SEMANTIC_SEARCH=true
FEATURE_ADMIN_PANEL=true
FEATURE_MONITORING=true


