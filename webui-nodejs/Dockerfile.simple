# Simplified Dockerfile for faster builds with Podman
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies (this is the slowest part)
# Try npm ci first (faster, requires lock file), fall back to npm install if lock file is out of sync
RUN (npm ci --prefer-offline --no-audit --silent || \
     (echo "===== package-lock.json out of sync, running npm install =====" && \
      npm install --prefer-offline --no-audit --silent))

# Copy source code
COPY . .

# Build the application
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Set permissions
RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Use standalone output
CMD ["node", ".next/standalone/server.js"]














